{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoxeLibre Test Runner configuration",
  "description": "Configuration file for the vltest command-line interface.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "voxelibre": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clone_dir": {
          "description": "Path to the VoxeLibre clone. Defaults to the current working directory.",
          "type": "string",
          "pattern": "\\S",
          "default": "."
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "description": "Container engine to use.",
          "type": "string",
          "enum": [
            "auto",
            "docker",
            "podman"
          ],
          "default": "auto"
        },
        "workspace_container": {
          "description": "Container holding the checkout: auto detects a containerized CLI, none uses daemon-side bind paths, or specify a container ID/name.",
          "type": "string",
          "pattern": "^[^-\\s][^\\s]*$",
          "default": "auto"
        },
        "server_image": {
          "description": "Local or remote Luanti server builds image.",
          "type": "string",
          "pattern": "\\S",
          "default": "git.minetest.land/voxelibre/voxelibre-test/luanti-server:master"
        },
        "client_image": {
          "description": "Local or remote Luanti client builds image.",
          "type": "string",
          "pattern": "\\S",
          "default": "git.minetest.land/voxelibre/voxelibre-test/luanti-client:master"
        },
        "tools_image": {
          "description": "Local or remote linting tools image.",
          "type": "string",
          "pattern": "\\S",
          "default": "git.minetest.land/voxelibre/voxelibre-test/tools:master"
        },
        "pull_policy": {
          "description": "Image pull policy.",
          "type": "string",
          "enum": [
            "always",
            "missing",
            "never"
          ],
          "default": "missing"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_dir": {
          "description": "Persistent directory for version-isolated client profiles. An empty value makes client sessions ephemeral.",
          "type": "string",
          "default": ""
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_level": {
          "description": "Minimum LuaLS diagnostic level to report.",
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning"
        },
        "output_format": {
          "description": "Lint display backend: readable text or GitHub Actions workflow commands.",
          "type": "string",
          "enum": ["human", "github"],
          "default": "human"
        },
        "color": {
          "description": "Colors for human lint output. Auto enables colors on terminals unless NO_COLOR is set or TERM is dumb.",
          "type": "string",
          "enum": ["auto", "always", "never"],
          "default": "auto"
        }
      }
    },
    "extract_builds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_dir": {
          "description": "Directory in which extracted build directories are created.",
          "type": "string",
          "pattern": "\\S",
          "default": "./builds"
        }
      }
    }
  }
}
